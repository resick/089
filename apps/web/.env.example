# Copy to .env.local. Validated by src/env.ts (schema in packages/core/src/env.ts).
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3089

# Supabase (docs/ARCHITECTURE.md). Only the publishable key (sb_publishable_…)
# belongs here; it is public by design and RLS protects the data. Never a
# secret / service_role key: the env schema refuses anything else.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
