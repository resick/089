# Copy to .env.local. Validated by src/lib/env.ts (schema in packages/core/src/env.ts).
# Everything here ends up in the app bundle: never put secrets in this file.
EXPO_PUBLIC_APP_ENV=local

# Map style for the scaffold spike: MapLibre's public demo tiles (low detail,
# free, no key). Replaced by our self-hosted Protomaps style in slice 7.
EXPO_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
