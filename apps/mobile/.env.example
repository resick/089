# Copy to .env.local. Validated by src/lib/env.ts (schema in packages/core/src/env.ts).
# Everything here ends up in the app bundle: never put secrets in this file.
EXPO_PUBLIC_APP_ENV=local

# Basemap styles: OpenFreeMap (free, no key, commercial use allowed, OSM data;
# attribution shown by MapLibre). Interim until our self-hosted Protomaps
# style in slice 7 (ADR-028).
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
EXPO_PUBLIC_MAP_STYLE_URL_LIGHT=https://tiles.openfreemap.org/styles/positron
