{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@089/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "website",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@089/web", "dev"],
      "port": 3089
    }
  ]
}
